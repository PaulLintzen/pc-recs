---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Mid-Range Desktop (~$1,000)" description="Best PC builds around $1,000 for 1440p gaming.">
  <section class="page-hero">
    <a href="/" class="back-link">← Home</a>
    <p class="section-label" style="color: var(--accent-mid);">Mid-Range · ~$1,000</p>
    <h1>Mid-range<br />desktop.</h1>
    <p>The sweet spot for most people. Strong 1440p gaming, fast productivity, and plenty of headroom to upgrade over time.</p>
  </section>

  <section class="page-content">
    <div class="section-label" style="margin-bottom: 0.5rem;">Recommended builds</div>
    <p class="section-subtitle">Builds coming soon — check back shortly.</p>

    <div class="build-placeholder">
      🔧 Build recommendations will live here. Each card will include a full parts list, where to buy, and expected performance.
    </div>
  </section>
</BaseLayout>