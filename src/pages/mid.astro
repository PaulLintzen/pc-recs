---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuildCard from '../components/BuildCard.astro';
import { builds } from '../data/builds.ts';

const budgetBuilds = builds.filter(b => b.tier === 'mid');
---
<BaseLayout title="Mid-Range Desktop" description="Best PC builds around $1,000 for 1440p gaming.">
  <section class="page-hero">
    <a href="/pc-recs" class="back-link">← Home</a>
    <p class="section-label" style="color: var(--accent-mid);">Mid-Range · $1,300</p>
    <h1>Mid-range<br />desktop.</h1>
    <p>The sweet spot for most people. Strong 1440p gaming, fast productivity, and plenty of headroom to upgrade over time.</p>
  </section>

  <section class="page-content">
    {budgetBuilds.map(build => (
      <BuildCard build={build} />
    ))}
  </section>
</BaseLayout>