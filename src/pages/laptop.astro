---
import BaseLayout from '../layouts/BaseLayout.astro';

const resources = [
  {
    name: "Best Laptop Deals",
    description: "All Laptops: Up to date pricing data on top recommended laptops.",
    url: "https://www.bestlaptop.deals/",
  },
  {
    name: "Gaming Laptop Deals",
    description: "Gaming Laptop Specific: Live pricing for discounted gaming laptops today.",
    url: "https://gaminglaptop.deals/",
  },
];
const channels = [
  {
    name: "Just Josh",
    description: "Great resource for complete laptop reviews and recommendations. Also the creator of the best laptop deals website.",
    url: "https://www.youtube.com/@JustJoshTech",
  },
  {
    name: "Jarrod's Tech",
    description: "In depth video reviews covering performance of gaming laptops. Also the creator of the gaming laptop deals website.",
    url: "https://www.youtube.com/@JarrodsTech",
  },
];
---
<BaseLayout title="Laptops" description="Laptop buying resources and recommendations.">
  <section class="page-hero">
    <a href="/pc-recs" class="back-link">← Home</a>
    <p class="section-label">Laptops</p>
    <h1>Laptop<br />resources.</h1>
    <p>You will pay a premium for performance in laptops over desktops but if you need a mobile machine, here are my recommendations. Laptop prices and availability are constantly fluctuating. There is no easy, one size fits all recommendation. So here's the websites I personally count on to track current deals and get accurate reviews.</p>
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.75rem;">
    Tip: Once you find a laptop you like, check out open box deals at your local BestBuy and Microcenter. They often have great prices that don't get picked up by these general web deal finders.
    </p>
  </section>

  <section class="page-content">
    <div class="section-label" style="margin-bottom: 1rem;">Up to Date Deal Sites</div>
    <div class="resource-list">
      {resources.map(r => (
        <a href={r.url} target="_blank" rel="noopener noreferrer" class="resource-link">
          <div class="resource-link-text">
            <h3>{r.name}</h3>
            <p>{r.description}</p>
          </div>
          <span class="resource-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>

    <br>

    <div class="section-label" style="margin-bottom: 1rem;">Video Reviews</div>
    <div class="resource-list">
      {channels.map(r => (
        <a href={r.url} target="_blank" rel="noopener noreferrer" class="resource-link">
          <div class="resource-link-text">
            <h3>{r.name}</h3>
            <p>{r.description}</p>
          </div>
          <span class="resource-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>