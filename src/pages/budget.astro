---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuildCard from '../components/BuildCard.astro';
import { builds } from '../data/builds.ts';

const tierBuilds = builds.filter(b => b.tier === 'budget');

const standard = tierBuilds.filter(b => b.variant === 'standard');
const microcenter = tierBuilds.filter(b => b.variant === 'microcenter');
const nvidia = tierBuilds.filter(b => b.variant === 'nvidia');
---
<BaseLayout title="Budget Desktop" description="Best PC builds around $700 for 1080p gaming and everyday use.">
  <section class="page-hero wide">
    <a href="/pc-recs" class="back-link">← Home</a>
    <p class="section-label" style="color: var(--accent-budget);">Budget · $700</p>
    <h1>Budget<br />desktop</h1>
    <p>Good basic 1080p gaming and snappy everyday performance. To hit this price point, these builds are using last generation hardware which means future upgrades are more limited. If you just need something now and can't stretch your budget look no further.</p>
  </section>

  <section class="page-content wide">
  <div class="build-grid">
    <div class="build-group">
      <p class="section-label">Microcenter Bundle</p>
      {microcenter.map(build => <BuildCard build={build} />)}
    </div>

    <div class="build-group">
      <p class="section-label">Standard</p>
      {standard.map(build => <BuildCard build={build} />)}
    </div>

    <div class="build-group">
      <p class="section-label">Nvidia Option</p>
      {nvidia.map(build => <BuildCard build={build} />)}
    </div>
  </section>
</BaseLayout>