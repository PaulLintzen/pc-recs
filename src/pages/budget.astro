---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuildCard from '../components/BuildCard.astro';
import { builds } from '../data/builds.ts';

const budgetBuilds = builds.filter(b => b.tier === 'budget');
---
<BaseLayout title="Budget Desktop (~$500)" description="Best PC builds around $500 for 1080p gaming and everyday use.">
  <section class="page-hero">
    <a href="/" class="back-link">← Home</a>
    <p class="section-label" style="color: var(--accent-budget);">Budget · ~$500</p>
    <h1>Budget<br />desktop.</h1>
    <p>Good basic 1080p gaming and snappy everyday performance. These builds are often using last generation hardware as there are better and more frequent discounts but this means future upgrades are more limited.</p>
  </section>

  <section class="page-content">
    {budgetBuilds.map(build => (
      <BuildCard build={build} />
    ))}
  </section>
</BaseLayout>