---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuildCard from '../components/BuildCard.astro';
import { builds } from '../data/builds.ts';

const budgetBuilds = builds.filter(b => b.tier === 'budget');
---
<BaseLayout title="Budget Desktop" description="Best PC builds around $500 for 1080p gaming and everyday use.">
  <section class="page-hero">
    <a href="/pc-recs" class="back-link">← Home</a>
    <p class="section-label" style="color: var(--accent-budget);">Budget · $650</p>
    <h1>Budget<br />desktop.</h1>
    <p>Good basic 1080p gaming and snappy everyday performance. To hit this price point, this build is using last generation hardware which means future upgrades are more limited. If you just need something now and can't stretch your budget look no further.</p>
  </section>

  <section class="page-content">
    {budgetBuilds.map(build => (
      <BuildCard build={build} />
    ))}
  </section>
</BaseLayout>